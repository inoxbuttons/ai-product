# --- LLM: любой OpenAI-совместимый API. Чтобы сменить модель/провайдера, меняйте только эти переменные. ---

# Cloud.ru Evolution Foundation Models (GigaChat). Ключ создаётся в консоли cloud.ru.
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=
# Точный ID модели смотрите в каталоге моделей cloud.ru или командой `npm run models`.
LLM_MODEL=GigaChat/GigaChat-3-Pro

# Примеры других провайдеров:
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama

# --- Необязательные параметры ---
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=3000
# LLM_TIMEOUT_MS=90000
# Включить response_format=json_object (только если провайдер его поддерживает)
# LLM_JSON_MODE=false
# PORT=3000
