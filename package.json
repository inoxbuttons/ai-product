{
  "name": "product-card-assistant",
  "version": "1.0.0",
  "description": "AI-помощник для подготовки товарных карточек КИП (LangChain + OpenAI-совместимый API)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "examples": "tsx scripts/run-examples.ts",
    "models": "tsx scripts/list-models.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/openai": "^1.8.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
